**/*.pem
**/*.p12
**/*.pfx
**/*.jks
**/*credentials*.json
**/*secret*.json
**/*-password
**/*.password
**/.dynsec-admin-init
**/id_rsa
**/id_ed25519
**/.ssh
**/.aws

